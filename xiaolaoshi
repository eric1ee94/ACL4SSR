# FlClash / mihomo 修复版配置
# 修复日期: 2026-08-19
# 基于原 flclash.yml 修复以下问题：
#  1. fake-ip-filter 误配 "*"（等于禁用 fake-ip，导致 TUN 断网）→ 删除，改为白名单式真实 IP 列表
#  2. GEOIP 数据源指向 kelee.one（实测 403，GEOIP 规则全废）→ 换 Loyalsoldier 官方源
#  3. prefer-h3: true（DoH 走 QUIC，易被干扰导致解析超时）→ false
#  4. find-process-mode: strict（macOS 高 CPU）→ false
#  5. 节点健康检查 6 秒一次（CPU/流量风暴）→ 60 秒
#  6. sniffer 全量 override（每个连接嗅探+改目的地，高 CPU）→ 只嗅探不改目的地
#  7. tun.stack: system → gvisor（大幅降低 CPU）
#  8. fake-ip-range 28.0.0.1/8（公网真实段）→ 198.18.0.1/16（IANA 保留测试段）
#  9. DNS 增加 fallback + fallback-filter（防污染）+ respect-rules
# 改动记录:
# [2026-08-31] 新增订阅 Sub2（备注 GoMaMi，来源 mmw.xiaov.uno），并在全部活跃策略组 use 中引用
#   - 订阅原始链接 t=loon 返回 Loon 节点格式，mihomo provider 无法解析 → 改用 t=clash 参数
#   - 原注释占位的 Sub2（守候高级 sub1.sntp.dev）被本订阅替换
# [2026-09-16] 精简版：节点只保留华纳香港（SE3-Huana-HK🇭🇰）
#   - SE1-Ktti-JP / SE2-ISIF-HK-COP / SE4-Dmit-US 节点定义已注释（保留参数便于恢复）
#   - 全部策略组 proxies 中仅保留 SE3-Huana-HK🇭🇰
#   - Sub1 / Sub2 订阅 provider 及各组 use 引用已注释，避免订阅节点混入
# [2026-09-16] 策略组精简：只保留 Proxy 与 漏网之鱼
#   - 其余 18 个策略组（Netflix/Max/Youtube/Spotify/Bilibili/Telegram/SocialMedia/Speedtest/
#     PayPal/TestFlight/Apple/GoogleVoice/Google/Microsoft/Emby/NBA/Formula1/AIGC）已整块注释
#   - 规则出口同步重映射（共 82 条），避免悬空引用：
#       Emby(3) / Bilibili(2) → DIRECT（自建媒体、国内视频保持直连语义）
#       其余 77 条 → Proxy（Formula1 39 / NBA 14 / SocialMedia 6 / Telegram 3 / 其余 15）
#   - 指向 DIRECT / REJECT / Proxy / 漏网之鱼 的规则未改动

port: 7890
socks-port: 7891
mixed-port: 7892
redir-port: 7893
tproxy-port: 7894

unified-delay: true
geodata-mode: false
geodata-loader: standard
geo-auto-update: true
geo-update-interval: 24
tcp-concurrent: true
find-process-mode: "off"

allow-lan: true
mode: rule
log-level: info
ipv6: false
udp: true

external-controller: 0.0.0.0:9090
# external-ui: ui
# external-ui-url: 'https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip'

geox-url:
  # GEOIP: MetaCubeX geoip.metadb（全球全量：国家 + 厂商 ASN 分类，已验证 google/telegram/netflix/cn 均可用）
  mmdb: 'https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/release/geoip.metadb'
  # GEOSITE: 保持 Loyalsoldier 官方源（geosite 不依赖 mmdb）
  geosite: 'https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat'

profile:
  store-selected: true
  store-fake-ip: true

sniffer:
  enable: true
  force-dns-mapping: false
  parse-pure-ip: false
  override-destination: false
  sniff:
    HTTP:
      ports: [80, 8080-8880]
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]
  force-domain:
    - +.v2ex.com

  skip-domain:
    - Mijia Cloud

tun:
  enable: true
  # [2026-08-28] stack 改回 system：gvisor 在 Stash 上不兼容（TUN 断网）
  stack: system
  dns-hijack:
    - any:53
  auto-route: true
  auto-detect-interface: true

# P2P下载端口
listeners:
- name: socks5-in-1
  type: socks
  port: 10808
  listen: 0.0.0.0
  udp: true
  users: []
  proxy: DIRECT

dns:
  enable: true
  prefer-h3: false
  listen: 0.0.0.0:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*"
    - "+.lan"
    # --- 游戏联机：必须真实 IP（Surge/Stash 语法 +. 前缀） ---
    - "+.srv.nintendo.net"
    - "+.stun.playstation.net"
    - "+.xboxlive.com"
    - "+.battlenet.com.cn"
    - "+.battlenet.com"
    - "+.blzstatic.cn"
    - "+.battle.net"
    # --- 用户服务：Emby / 媒体 302 直链播放 ---
    - "+.gugumedia.de"
    - "+.gugumedia.link"
    - "+.misakaf.org"
    # --- 国内 IM 长连接（对 fake-ip 敏感） ---
    - "+.qq.com"
    - "+.wechat.com"
    - "+.weixin.qq.com"
    # --- 本地 ---
    - "localhost.ptlogin2.qq.com"
  default-nameserver:
    - 223.5.5.5
    - 223.6.6.6
  nameserver:
    - https://223.5.5.5/dns-query
    - https://223.6.6.6/dns-query

